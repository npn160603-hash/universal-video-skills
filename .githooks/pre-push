#!/bin/sh
# Guard against accidental destructive pushes.
# Blocks: pushes to main, force pushes (non-fast-forward), and branch deletion.
# Enable with: git config core.hooksPath .githooks
# Bypass is deliberately not supported here; change the hook in a reviewed commit instead.

remote="$1"
zero="0000000000000000000000000000000000000000"
status=0

while read local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
        echo "pre-push guard: refusing to push to $remote_ref (protected)." >&2
        status=1
        continue
    fi
    if [ "$local_sha" = "$zero" ]; then
        echo "pre-push guard: refusing to delete $remote_ref." >&2
        status=1
        continue
    fi
    if [ "$remote_sha" != "$zero" ]; then
        # Remote tip must be an ancestor of the local tip (fast-forward only).
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            echo "pre-push guard: $remote_ref would be rewritten (non-fast-forward). Refusing." >&2
            status=1
        fi
    fi
done

exit $status
